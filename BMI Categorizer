#include <stdio.h>

int main() {
    float height, weight, bmi;

    printf("Enter Your Height in Meter: ");
    scanf(" %f", &height);

    printf("Enter Your Weight in Kilogram:");
    scanf(" %f", &weight);

    if (weight <= 0 || height <= 0) {
        printf("Invalid Height or Weight!");
            return 1;
    }

    bmi = weight / (height * height); 

    printf("Your BMI is: %.2f\n", bmi);
    
    if (bmi < 18.5) {
        printf("Underweight");    
    }
    else if(bmi < 25) {
        printf("Normal");
    }
    else if(bmi < 30) {
        printf("Overweight");   
    }
    else if (bmi >= 30) {
        printf("Obese");
    }
    return 0;
}
