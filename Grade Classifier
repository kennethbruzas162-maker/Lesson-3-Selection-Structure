#include <stdio.h>

int main() {

    int grade;
    
    printf("Enter Your Grade: ");
    scanf("%d" , &grade);
    
    if (grade >= 90) {
        printf("Grade: A");
    }
    else if(grade >= 80) {
        printf("Grade: B");
    }
    else if(grade >= 70) {
        printf("Grade: C");
    }
    else if(grade >= 60) {
        printf("Grade: D");
    }
     else if(grade < 60) {
        printf("Grade: F");
    }
    return 0;
}
